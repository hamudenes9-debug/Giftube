<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Emoji Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/emoji_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <!-- Emoji Categories -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#EEEEEE">

        <Button android:id="@+id/cat_smile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="😊" />
        <Button android:id="@+id/cat_animal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="🐶" />
        <Button android:id="@+id/cat_food" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="🍕" />
        <Button android:id="@+id/cat_activity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⚽" />
        <Button android:id="@+id/cat_travel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="🚗" />

    </LinearLayout>

</LinearLayout>
